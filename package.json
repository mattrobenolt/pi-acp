{
  "name": "pi-acp",
  "version": "0.0.27",
  "description": "ACP adapter for pi coding agent",
  "keywords": [
    "acp",
    "adapter",
    "agent-client-protocol",
    "pi-coding-agent"
  ],
  "homepage": "https://github.com/mattrobenolt/pi-acp#readme",
  "bugs": {
    "url": "https://github.com/mattrobenolt/pi-acp/issues"
  },
  "license": "MIT",
  "author": "Matt Robenolt",
  "repository": {
    "type": "git",
    "url": "https://github.com/mattrobenolt/pi-acp.git"
  },
  "bin": {
    "pi-acp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.js",
    "fmt": "env -u NODE_PATH ./node_modules/.bin/oxfmt .",
    "fmt:check": "env -u NODE_PATH ./node_modules/.bin/oxfmt . --check",
    "lint": "env -u NODE_PATH ./node_modules/.bin/oxlint . --deny-warnings",
    "check": "tsgo --noEmit",
    "typecheck": "tsgo --noEmit",
    "test": "node --import tsx --test 'test/*.test.ts' 'test/**/*.test.ts'",
    "smoke": "node scripts/smoke-acp.mjs",
    "smoke:eval": "node scripts/smoke-eval.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test && npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@typescript/native-preview": "^7.0.0-dev.20260514.1",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.22.0",
    "typescript-language-server": "^5.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
